.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  background: #f5f6f8;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 提示框 */
.tip-box {
  display: flex;
  align-items: flex-start;
  background: #fff7e6;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}
.tip-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1.4;
}
.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8c6d1f;
  margin-bottom: 8rpx;
}
.tip-text {
  font-size: 26rpx;
  color: #a08540;
  line-height: 1.6;
}

/* 输入框组 */
.input-group {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.input-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  width: 140rpx;
  flex-shrink: 0;
  line-height: 88rpx;
}
.input-field {
  flex: 1;
  height: 88rpx;
  background: #f7f8fa;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #303133;
  box-sizing: border-box;
}
.input-placeholder {
  color: #c0c4cc;
  font-size: 28rpx;
}

/* 按钮组 */
.button-group {
  display: flex;
  gap: 24rpx;
}
.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn[disabled] {
  opacity: 0.5;
}
.btn-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #ff8c42, #ff6b2c);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 44, 0.3);
}
.btn-outline {
  background: #fff;
  color: #f56c6c;
  border: 2rpx solid #f56c6c;
}

/* 底部说明 */
.footer-note {
  text-align: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #909399;
}
