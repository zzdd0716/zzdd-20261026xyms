.page { min-height: 100vh; padding: 20rpx 24rpx 60rpx; }

.banner {
  background: linear-gradient(135deg, #2b2f36, #3d4350);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.banner-title { font-size: 34rpx; font-weight: 700; }
.banner-sub { font-size: 22rpx; opacity: 0.8; margin-top: 10rpx; word-break: break-all; }

.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.grid-item {
  width: calc((100% - 20rpx) / 2);
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.grid-item:active { background: #fff8f4; }
.grid-icon { font-size: 56rpx; margin-bottom: 12rpx; }
.grid-name { font-size: 30rpx; font-weight: 700; color: #303133; }
.grid-desc { font-size: 22rpx; color: #909399; margin-top: 6rpx; }

.tip { margin: 40rpx 20rpx 0; font-size: 22rpx; color: #b0b3ba; text-align: center; line-height: 1.7; }
