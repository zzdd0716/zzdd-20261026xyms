.page { min-height: 100vh; background: #f5f6f8; padding-bottom: 40rpx; }

.banner {
  background: linear-gradient(135deg, #ff8c42, #ff6b2c);
  padding: 48rpx 32rpx 72rpx;
  color: #fff;
}
.banner-title { font-size: 38rpx; font-weight: 700; }
.banner-sub { font-size: 24rpx; opacity: 0.85; margin-top: 10rpx; }

.grid {
  margin: 24rpx 24rpx 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: 48%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  margin-bottom: 20rpx;
}
.grid-item:active { background: #fff8f4; transform: scale(0.98); transition: all 0.1s; }
.grid-icon {
  font-size: 52rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 80rpx;
  height: 80rpx;
  background: #fff4ee;
  border-radius: 16rpx;
}
.grid-name { font-size: 30rpx; font-weight: 700; color: #303133; margin-top: 8rpx; }
.grid-desc { font-size: 22rpx; color: #909399; margin-top: 6rpx; line-height: 1.4; }

/* 桌子图标 */
.table-icon { position: relative; width: 48rpx; height: 40rpx; margin-left: 16rpx; }
.table-top {
  width: 46rpx;
  height: 10rpx;
  background: linear-gradient(180deg, #c8895a, #a0683c);
  border-radius: 5rpx;
  position: absolute;
  top: 12rpx;
  left: 1rpx;
}
.table-leg {
  width: 7rpx;
  height: 22rpx;
  background: linear-gradient(180deg, #a0683c, #7a4e2a);
  position: absolute;
  top: 22rpx;
  border-radius: 0 0 3rpx 3rpx;
}
.leg-left { left: 10rpx; }
.leg-right { right: 10rpx; }

.tip { margin: 40rpx 20rpx 0; font-size: 22rpx; color: #b0b3ba; text-align: center; line-height: 1.7; }
