.page { min-height: 100vh; padding: 20rpx 0 60rpx; }

.top-bar { position: sticky; top: 0; z-index: 10; background: #f6f7f9; padding-bottom: 16rpx; }
.filter-bar {
  background: #fff;
  white-space: nowrap;
  padding: 16rpx 24rpx;
}
.filter-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 12rpx;
  font-size: 28rpx;
  color: #606266;
  border-radius: 32rpx;
  background: #f6f7f9;
}
.filter-item.active { background: #ff6b2c; color: #fff; font-weight: 600; }

.search-row { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 24rpx 0; }
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.sort-btn {
  flex-shrink: 0;
  background: #fff;
  color: #606266;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}
.sort-btn.active { color: #ff6b2c; border: 2rpx solid #ff6b2c; padding: 12rpx 26rpx; }

.top-actions { display: flex; gap: 16rpx; margin: 16rpx 24rpx 0; }
.clearance-btn { flex: 1; text-align: center; line-height: 80rpx; height: 80rpx; font-size: 28rpx; }
.add-btn {
  flex: 1;
  text-align: center;
  line-height: 80rpx;
  height: 80rpx;
  font-size: 28rpx;
}

.dish-card { display: flex; margin: 0 24rpx 20rpx; }
.dish-img { width: 140rpx; height: 140rpx; border-radius: 14rpx; overflow: hidden; flex-shrink: 0; background: #f6f7f9; display: flex; align-items: center; justify-content: center; }
.dish-img-pic { width: 100%; height: 100%; }
.dish-img-empty { font-size: 56rpx; }

.dish-info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.dish-name-row { display: flex; align-items: center; gap: 12rpx; }
.dish-name { font-size: 30rpx; font-weight: 600; color: #303133; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dish-meta { font-size: 24rpx; color: #909399; margin-top: 8rpx; }

.dish-price-row { margin-top: auto; display: flex; justify-content: space-between; align-items: center; }
.dish-price { color: #ff6b2c; font-weight: 700; font-size: 30rpx; }
.dish-actions { display: flex; gap: 12rpx; }
.mini-btn {
  font-size: 22rpx;
  color: #606266;
  border: 2rpx solid #dcdfe6;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  background: #fff;
}
.mini-btn.danger { color: #e5484d; border-color: #e5484d; }
.mini-btn:active { opacity: 0.7; }
