.page { min-height: 100vh; padding: 20rpx 24rpx 60rpx; }

.head-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.head-amount { font-size: 40rpx; font-weight: 700; color: #ff6b2c; }
.meta { font-size: 26rpx; color: #606266; line-height: 1.9; }

.advance-row { margin-top: 20rpx; }
.advance-btn { width: 100%; text-align: center; }

.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f6f7f9;
}
.item-row:last-child { border-bottom: none; }
.item-main { flex: 1; min-width: 0; margin-right: 20rpx; display: flex; flex-direction: column; }
.item-name { font-size: 28rpx; font-weight: 600; color: #303133; }
.item-spec { font-size: 24rpx; color: #909399; margin-top: 4rpx; }
.item-remark { font-size: 24rpx; color: #e6a23c; margin-top: 4rpx; }
.item-qty { font-size: 24rpx; color: #606266; margin-top: 4rpx; }

.item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.item-price { font-size: 28rpx; font-weight: 600; color: #ff6b2c; }
.item-actions { display: flex; gap: 12rpx; }
.mini-btn {
  font-size: 22rpx;
  color: #ff6b2c;
  border: 2rpx solid #ff6b2c;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  background: #fff;
}
.mini-btn.danger { color: #e5484d; border-color: #e5484d; }
.mini-btn:active { opacity: 0.7; }

.empty { text-align: center; color: #b0b3ba; padding: 40rpx 0; font-size: 26rpx; }
