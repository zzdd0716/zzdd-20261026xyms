.page { min-height: 100vh; padding: 20rpx 24rpx 60rpx; }

.toolbar { margin-bottom: 20rpx; }
.add-btn { display: inline-block; text-align: center; line-height: 72rpx; height: 72rpx; font-size: 28rpx; padding: 0 40rpx; }

.table-card { display: flex; justify-content: space-between; align-items: center; }
.table-no { font-size: 30rpx; font-weight: 600; color: #303133; }
.table-meta { font-size: 24rpx; color: #909399; margin-top: 8rpx; }
.table-actions { display: flex; gap: 12rpx; }

.mini-btn {
  font-size: 22rpx;
  color: #606266;
  border: 2rpx solid #dcdfe6;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  background: #fff;
}
.mini-btn.danger { color: #e5484d; border-color: #e5484d; }
.mini-btn:active { opacity: 0.7; }

.dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}
.dialog-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.form-row { display: flex; align-items: center; padding: 16rpx 0; }
.form-label { width: 140rpx; font-size: 28rpx; color: #606266; }
.form-input { flex: 1; font-size: 28rpx; background: #f6f7f9; border-radius: 10rpx; padding: 0 18rpx; height: 68rpx; line-height: 68rpx; box-sizing: border-box; }
.dialog-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.dlg-btn { flex: 1; text-align: center; line-height: 76rpx; height: 76rpx; font-size: 28rpx; }
