<wxs module="fmt">
module.exports = function (n) {
  var v = n * 1;
  if (v !== v) return '0.00';
  var neg = v < 0;
  if (neg) v = -v;
  var cents = Math.floor(v * 100 + 0.5);
  var intPart = Math.floor(cents / 100);
  var decPart = cents % 100;
  var dec = decPart < 10 ? '0' + decPart : '' + decPart;
  var r = intPart + '.' + dec;
  return neg ? '-' + r : r;
}
</wxs>

<view class="page">
  <!-- 顶部门店信息 -->
  <view class="header">
    <view class="header-shop">
      <view class="shop-name">
        <image class="shop-logo" src="/images/logo.png" mode="aspectFill"></image>
        <text>禧粤美食</text>
      </view>
      <view class="shop-meta" wx:if="{{isPickup}}">自提打包 · 选好菜加入购物车</view>
      <view class="shop-meta" wx:elif="{{tableNo}}">桌号：{{tableNo}} · 选好菜加入购物车</view>
    </view>
  </view>

  <!-- 自提模式提示（自提码进入：默认打包且不可更改） -->
  <view class="pickup-banner" wx:if="{{isPickup}}">
    <text class="pickup-banner-icon">🥡</text>
    <text class="pickup-banner-text">自提取餐 · 所有菜品默认打包，规格中的堂食/打包不可修改</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索菜品名称"
        value="{{keyword}}"
        bindinput="onKeywordInput" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">✕</view>
    </view>
  </view>

  <!-- AI 推荐入口 -->
  <view class="ai-banner" bindtap="openAiDialog">
    <text class="ai-banner-icon">🤖</text>
    <text class="ai-banner-text">不知道吃什么？AI帮你推荐</text>
    <text class="ai-banner-arrow">›</text>
  </view>

  <!-- 分类 + 菜品 左右两栏 -->
  <view class="content">
    <!-- 左侧竖向分类导航 -->
    <scroll-view scroll-y class="cate-bar" wx:if="{{categories.length > 0}}">
      <view
        class="cate-item {{activeCate === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="switchCate">{{item.name}}</view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view scroll-y class="dish-list">
      <view wx:if="{{loading}}" class="empty-tip"><text class="empty-icon">⏳</text>菜单加载中…</view>
      <block wx:elif="{{filteredList.length > 0}}">
        <view class="dish-card" wx:for="{{filteredList}}" wx:key="id">
          <view class="dish-img">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="dish-img-pic" />
            <view wx:else class="dish-img-empty">🍛</view>
          </view>
          <view class="dish-info">
            <view class="dish-name">{{item.name}}</view>
            <view class="dish-desc" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="dish-sold" wx:if="{{item.soldCount > 0}}">已售 {{item.soldCount}}</view>
            <view class="dish-price-row">
              <view class="dish-price">¥<text class="price-int">{{fmt(item.price)}}</text></view>
              <view class="dish-add-area">
                <text class="dish-picked" wx:if="{{cartQtyMap[item.id] > 0}}">已选 {{cartQtyMap[item.id]}} 份</text>
                <view class="spec-open-btn" data-id="{{item.id}}" bindtap="openSpec">选规格</view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="empty-tip"><text class="empty-icon">🍽️</text>该分类暂无菜品</view>
    </scroll-view>
  </view>

  <!-- 悬浮购物车挂件（常显，空车时置灰） -->
  <view class="cart-fab {{cartCount > 0 ? '' : 'cart-empty'}}" bindtap="goCart">
    <view class="cart-fab-icon">🛒<text class="cart-fab-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text></view>
  </view>

  <!-- 购物车明细弹窗 -->
  <view class="cart-popup-mask" wx:if="{{cartPopupVisible}}" bindtap="closeCartPopup">
    <view class="cart-popup" catchtap="noop">
      <view class="cart-popup-head">
        <text class="cart-popup-title">已选菜品</text>
        <text class="cart-popup-clear" bindtap="clearCart">清空</text>
      </view>
      <scroll-view scroll-y class="cart-popup-list">
        <view class="cart-popup-item" wx:for="{{cartList}}" wx:key="key" wx:for-item="item">
          <view class="cart-item-info">
            <view class="cart-item-name">{{item.name}}</view>
            <view class="cart-item-spec" wx:if="{{item.specText}}">{{item.specText}}</view>
            <input
              class="cart-item-remark-input"
              placeholder="口味备注（选填）"
              placeholder-class="remark-placeholder"
              value="{{item.remark}}"
              data-key="{{item.key}}"
              bindinput="onCartRemarkInput" />
            <view class="cart-item-price">¥{{fmt(item.price)}}</view>
          </view>
          <view class="cart-item-stepper">
            <view class="step-btn minus" data-key="{{item.key}}" bindtap="cartItemDec">−</view>
            <view class="step-qty">{{item.qty}}</view>
            <view class="step-btn plus" data-key="{{item.key}}" bindtap="cartItemInc">＋</view>
          </view>
        </view>
      </scroll-view>
      <view class="cart-popup-foot">
        <view class="cart-popup-total">合计 <text class="money">¥{{fmt(cartTotal)}}</text></view>
        <view class="cart-popup-checkout" bindtap="goCheckout">去结算</view>
      </view>
    </view>
  </view>

  <!-- AI 推荐弹窗 -->
  <view class="ai-mask" wx:if="{{aiDialogVisible}}" bindtap="closeAiDialog">
    <view class="ai-dialog" catchtap="noop">
      <view class="ai-dialog-head">
        <text class="ai-dialog-title">🤖 AI 帮你点</text>
        <text class="ai-dialog-close" bindtap="closeAiDialog">✕</text>
      </view>

      <!-- 输入口味偏好 -->
      <view class="ai-input-area" wx:if="{{!aiResultVisible}}">
        <input
          class="ai-input"
          placeholder="说说你想吃什么口味？如：清淡的、不要辣"
          value="{{aiPreference}}"
          bindinput="onAiPreferenceInput"
          confirm-type="search"
          bindconfirm="doAiRecommend" />
        <view class="ai-submit-btn {{aiLoading ? 'disabled' : ''}}" bindtap="doAiRecommend">
          {{aiLoading ? 'AI 思考中…' : '开始推荐'}}
        </view>
      </view>

      <!-- 推荐结果 -->
      <view class="ai-result-area" wx:if="{{aiResultVisible}}">
        <view class="ai-result-title">为你推荐这几道：</view>
        <scroll-view scroll-y class="ai-result-list">
          <view class="ai-result-item" wx:for="{{aiRecommendList}}" wx:key="id">
            <view class="ai-result-info">
              <view class="ai-result-name">{{item.name}}</view>
              <view class="ai-result-price">¥{{fmt(item.price)}}</view>
            </view>
            <view class="ai-result-add" data-id="{{item.id}}" bindtap="addAiDishToCart">选它</view>
          </view>
        </scroll-view>
        <view class="ai-result-actions">
          <view class="ai-refresh-btn {{aiLoading ? 'disabled' : ''}}" bindtap="refreshAiRecommend">
            {{aiLoading ? 'AI思考中…' : '换一换'}}
          </view>
          <view class="ai-reset-btn" bindtap="resetAiDialog">重新输入</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选规格弹窗 -->
  <spec-dialog
    dish="{{specDish}}"
    visible="{{specVisible}}"
    bind:confirm="onSpecConfirm"
    bind:close="onSpecClose" />
</view>
