.page { height: 100vh; display: flex; flex-direction: column; }

/* 顶部 */
.header {
  background: linear-gradient(135deg, #ff6b2c, #ff9a5c);
  padding: 28rpx 32rpx;
  color: #fff;
  flex-shrink: 0;
}
.shop-name { font-size: 36rpx; font-weight: 700; display: flex; align-items: center; }
.shop-logo { width: 56rpx; height: 56rpx; border-radius: 50%; margin-right: 16rpx; background: #fff; }
.shop-meta { font-size: 24rpx; opacity: 0.92; margin-top: 8rpx; }

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}
.search-box {
  display: flex;
  align-items: center;
  background: #f6f7f9;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 64rpx;
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; opacity: 0.6; }
.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 64rpx;
}
.search-clear {
  font-size: 24rpx;
  color: #b0b3ba;
  padding: 0 8rpx;
}

/* 左右两栏内容区 */
.content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧竖向分类导航 */
.cate-bar {
  width: 140rpx;
  flex-shrink: 0;
  background: #f6f7f9;
  height: 100%;
}
.cate-item {
  display: block;
  text-align: center;
  padding: 30rpx 8rpx;
  font-size: 26rpx;
  color: #606266;
  position: relative;
  border-left: 6rpx solid transparent;
}
.cate-item.active {
  color: #ff6b2c;
  background: #fff;
  font-weight: 600;
  border-left-color: #ff6b2c;
}

/* 右侧菜品列表 */
.dish-list {
  flex: 1;
  padding: 20rpx 12rpx 180rpx 8rpx;
  height: 100%;
  box-sizing: border-box;
  background: #fff;
}
.dish-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.dish-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f6f7f9;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-img-pic { width: 100%; height: 100%; }
.dish-img-empty { font-size: 64rpx; }

.dish-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.dish-name { font-size: 32rpx; font-weight: 600; color: #303133; }
.dish-desc {
  font-size: 24rpx;
  color: #909399;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}
.dish-sold { font-size: 22rpx; color: #b0b3ba; margin-top: 6rpx; }

.dish-price-row {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.dish-price { color: #ff6b2c; font-weight: 700; font-size: 28rpx; }
.price-int { font-size: 36rpx; }

.dish-add-area {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
}
.dish-picked {
  font-size: 22rpx;
  color: #ff6b2c;
  margin-right: 16rpx;
  white-space: nowrap;
}
.spec-open-btn {
  background: #ff6b2c;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  white-space: nowrap;
}

/* 悬浮购物车挂件 */
.cart-fab {
  position: fixed;
  left: 24rpx;
  bottom: 200rpx;
  display: flex;
  align-items: center;
  background: #909399;
  border-radius: 48rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
}
.cart-fab-icon { font-size: 40rpx; position: relative; color: #fff; }
.cart-fab-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: #ff6b2c;
  color: #fff;
  font-size: 20rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 6rpx;
}
/* 空车状态 */
.cart-fab.cart-empty { background: #c0c4cc; }
.cart-fab.cart-empty .cart-fab-icon { opacity: 0.7; }

/* 购物车明细弹窗 */
.cart-popup-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 500;
  display: flex;
  align-items: flex-end;
}
.cart-popup {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  margin-bottom: 180rpx;
}
.cart-popup-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f0f1f3;
}
.cart-popup-title { font-size: 30rpx; font-weight: 700; color: #303133; }
.cart-popup-clear { font-size: 26rpx; color: #909399; }
.cart-popup-list { flex: 1; max-height: 45vh; padding: 0 32rpx; box-sizing: border-box; width: 100%; overflow: hidden; }
.cart-popup-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f6f7f9;
  width: 100%;
  box-sizing: border-box;
}
.cart-item-info { flex: 1; min-width: 0; overflow: hidden; padding-right: 16rpx; }
.cart-item-name { font-size: 28rpx; color: #303133; font-weight: 600; }
.cart-item-spec { font-size: 24rpx; color: #909399; margin-top: 6rpx; }
.cart-item-remark { font-size: 24rpx; color: #e6a23c; margin-top: 4rpx; }
.cart-item-remark-input {
  font-size: 24rpx;
  color: #e6a23c;
  margin-top: 6rpx;
  padding: 6rpx 12rpx;
  background: #fff8f0;
  border-radius: 8rpx;
  min-height: 40rpx;
  line-height: 40rpx;
}
.remark-placeholder { color: #c0c4cc; font-size: 22rpx; }
.cart-item-price { font-size: 28rpx; color: #ff6b2c; font-weight: 700; margin-top: 6rpx; }
.cart-item-stepper { display: flex; align-items: center; flex-shrink: 0; margin-left: 16rpx; width: 160rpx; justify-content: flex-end; }
.cart-popup .step-btn {
  width: 48rpx; height: 48rpx; line-height: 44rpx;
  text-align: center; font-size: 32rpx;
  border-radius: 50%; border: 2rpx solid #dcdfe6;
  color: #606266; background: #fff;
}
.cart-popup .step-btn.plus { border-color: #ff6b2c; color: #ff6b2c; }
.cart-popup .step-qty { min-width: 56rpx; text-align: center; font-size: 28rpx; color: #303133; }
.cart-popup-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 28rpx;
  border-top: 2rpx solid #f0f1f3;
}
.cart-popup-total { font-size: 28rpx; color: #303133; }
.cart-popup-total .money { color: #ff6b2c; font-size: 36rpx; font-weight: 700; }
.cart-popup-checkout {
  background: #ff6b2c;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}
