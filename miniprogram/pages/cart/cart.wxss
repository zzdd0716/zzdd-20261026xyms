.page { min-height: 100vh; padding: 20rpx 24rpx 60rpx; }

.shop-bar {
  font-size: 26rpx;
  color: #606266;
  padding: 8rpx 8rpx 20rpx;
}

.cart-item { display: flex; }
.cart-item-main { flex: 1; min-width: 0; margin-right: 20rpx; }
.cart-item-name { font-size: 30rpx; font-weight: 600; color: #303133; }
.cart-item-spec { font-size: 24rpx; color: #909399; margin-top: 6rpx; }
.cart-item-remark {
  background: #f6f7f9;
  border-radius: 10rpx;
  font-size: 24rpx;
  padding: 0 16rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin-top: 14rpx;
  width: 100%;
  box-sizing: border-box;
}
.cart-item-right { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
.cart-item-price { color: #ff6b2c; font-weight: 700; font-size: 30rpx; }
.cart-item-remove { font-size: 22rpx; color: #b0b3ba; padding: 6rpx 0; }

.cart-summary { margin-top: 8rpx; }
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #303133;
  margin-bottom: 24rpx;
}
.summary-row .money { font-size: 36rpx; }

.submit-btn { width: 100%; }

.empty-tip { text-align: center; padding: 160rpx 0; color: #b0b3ba; }
.go-menu { width: 280rpx; margin: 40rpx auto 0; }
