<wxs module="fmt">
module.exports = function (n) {
  var v = n * 1;
  if (v !== v) return '0.00';
  var neg = v < 0;
  if (neg) v = -v;
  var cents = Math.floor(v * 100 + 0.5);
  var intPart = Math.floor(cents / 100);
  var decPart = cents % 100;
  var dec = decPart < 10 ? '0' + decPart : '' + decPart;
  var r = intPart + '.' + dec;
  return neg ? '-' + r : r;
}
</wxs>

<view class="page">
  <view wx:if="{{loading}}" class="empty-tip"><text class="empty-icon">⏳</text>加载中…</view>

  <block wx:elif="{{orders.length > 0}}">
    <view class="order-card card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="order-head">
        <text class="order-no">单号 {{item.orderNo}}</text>
        <text class="tag {{item.statusTag}}">{{item.statusText}}</text>
      </view>
      <view class="order-meta">桌号 {{item.tableNoText}} · {{item.createTime || ''}}</view>
      <view class="order-foot">
        <text class="order-view">查看详情 ›</text>
        <text class="order-amount">¥{{fmt(item.totalAmount)}}</text>
      </view>
    </view>
  </block>

  <view wx:else class="empty-tip">
    <text class="empty-icon">🧾</text>
    还没有订单，快去点餐吧~
  </view>
</view>
