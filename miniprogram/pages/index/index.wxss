.page { min-height: 100vh; padding-bottom: 40rpx; }

.hero {
  background: linear-gradient(135deg, #ff6b2c, #ff9a5c);
  padding: 64rpx 40rpx 80rpx;
  text-align: center;
  color: #fff;
}
.hero-logo { font-size: 88rpx; margin-bottom: 16rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.92; margin-top: 10rpx; }

.table-panel {
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  min-height: 320rpx;
}
.panel-title { font-size: 32rpx; font-weight: 700; color: #303133; margin-bottom: 24rpx; }

.table-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.table-item {
  width: calc((100% - 40rpx) / 3);
  border: 2rpx solid #e4e6eb;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: all 0.15s;
}
.table-item:active { border-color: #ff6b2c; background: #fff5ef; }
.table-no { font-size: 34rpx; font-weight: 700; color: #303133; }
.table-seat { font-size: 22rpx; color: #909399; margin-top: 6rpx; }

.quick-enter {
  margin: 32rpx auto 0;
  width: 320rpx;
  color: #ff6b2c;
  font-size: 28rpx;
  border: 2rpx solid #ff6b2c;
  border-radius: 44rpx;
  padding: 16rpx 0;
}

.page-tip {
  margin: 32rpx 40rpx 0;
  font-size: 22rpx;
  color: #b0b3ba;
  text-align: center;
  line-height: 1.6;
}
