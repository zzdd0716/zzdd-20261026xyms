.page { min-height: 100vh; padding-bottom: 40rpx; }

.hero {
  background: linear-gradient(135deg, #ff9a5c, #ff6b2c);
  padding: 64rpx 40rpx 80rpx;
  text-align: center;
  color: #fff;
}
.hero-logo { width: 140rpx; height: 140rpx; border-radius: 50%; margin-bottom: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15); }
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.92; margin-top: 10rpx; }

.table-panel {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  min-height: 320rpx;
}
.panel-title { font-size: 32rpx; font-weight: 700; color: #303133; margin-bottom: 24rpx; }

.table-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.table-item {
  width: calc((100% - 40rpx) / 3);
  border: 2rpx solid #e4e6eb;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: all 0.15s;
}
.table-item:active { border-color: #ff6b2c; background: #fff5ef; }
.table-no { font-size: 34rpx; font-weight: 700; color: #303133; }
.table-seat { font-size: 22rpx; color: #909399; margin-top: 6rpx; }

.quick-enter {
  margin: 32rpx auto 0;
  width: 320rpx;
  color: #ff6b2c;
  font-size: 28rpx;
  border: 2rpx solid #ff6b2c;
  border-radius: 44rpx;
  padding: 16rpx 0;
}

/* 自提取餐入口（模拟扫描自提码） */
.pickup-panel {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
}
.pickup-panel:active { background: #fff8f3; }
.pickup-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #fff0e8;
  color: #ff6b2c;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.pickup-info { flex: 1; min-width: 0; }
.pickup-title { font-size: 30rpx; font-weight: 700; color: #303133; }
.pickup-sub { font-size: 22rpx; color: #909399; margin-top: 6rpx; }
.pickup-arrow { color: #c0c4cc; font-size: 32rpx; margin-left: 12rpx; }

.page-tip {
  margin: 32rpx 40rpx 0;
  font-size: 22rpx;
  color: #b0b3ba;
  text-align: center;
  line-height: 1.6;
}
