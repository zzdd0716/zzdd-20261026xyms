<view class="page">
  <view class="hero">
    <image class="hero-logo" src="/images/logo.png" mode="aspectFill"></image>
    <view class="hero-title">禧粤美食</view>
    <view class="hero-sub">选择你的桌号，开始点餐</view>
  </view>

  <view class="table-panel">
    <view class="panel-title">选择桌台</view>
    <view wx:if="{{loading}}" class="empty-tip">
      <text class="empty-icon">⏳</text>
      正在加载桌台…
    </view>
    <view wx:elif="{{tables.length > 0}}" class="table-grid">
      <view
        class="table-item"
        wx:for="{{tables}}"
        wx:key="id"
        data-table="{{item}}"
        bindtap="chooseTable">
        <view class="table-no">{{item.tableNo}}</view>
        <view class="table-seat">{{item.seatCount}} 人桌</view>
      </view>
    </view>
    <view wx:else class="empty-tip">
      <text class="empty-icon">🍽️</text>
      暂无桌台数据
      <view class="quick-enter" bindtap="quickEnter">直接进入 1 号桌</view>
    </view>
  </view>

  <!-- 自提取餐：模拟扫描"自提码"进入（正式环境由自提码 scene=type=pickup 自动进入） -->
  <view class="pickup-panel" bindtap="enterPickup">
    <view class="pickup-icon">🥡</view>
    <view class="pickup-info">
      <view class="pickup-title">自提取餐</view>
    </view>
    <view class="pickup-arrow">›</view>
  </view>

  <view class="page-tip">提示：正式上线后，顾客扫描桌上二维码即可自动识别桌号，无需手动选择</view>
</view>
