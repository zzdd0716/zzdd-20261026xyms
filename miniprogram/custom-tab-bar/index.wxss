.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 16rpx;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
}
.tab-text {
  font-size: 30rpx;
  color: #9a9ea6;
}
.tab-item.active .tab-text {
  color: #ff6b2c;
  font-weight: 600;
}
