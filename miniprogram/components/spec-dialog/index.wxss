.modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.spec-modal {
  width: 100%;
  max-height: 88vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.spec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 20rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.spec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #303133;
  flex: 1;
  margin-right: 20rpx;
}
.spec-price { color: #ff6b2c; font-size: 32rpx; font-weight: 700; }

.spec-body { flex: 1; min-height: 0; padding: 8rpx 24rpx; box-sizing: border-box; width: 100%; overflow: hidden; }

.spec-group { padding: 20rpx 0; }
.spec-group-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.spec-group-name { font-size: 28rpx; font-weight: 600; color: #303133; margin-right: 12rpx; }
.spec-group-rule { font-size: 20rpx; color: #909399; background: #f1f2f4; border-radius: 8rpx; padding: 2rpx 10rpx; }
.spec-group-rule.required { color: #ff6b2c; background: #fff0e8; }

.spec-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: repeat(4, auto);
  grid-auto-flow: column;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}
.spec-option {
  border: 2rpx solid #e4e6eb;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  color: #303133;
  background: #fff;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
}
.spec-option.active {
  border-color: #ff6b2c;
  color: #ff6b2c;
  background: #fff5ef;
}
.opt-delta { color: #ff6b2c; font-size: 22rpx; margin-left: 6rpx; flex-shrink: 0; }

.spec-remark-row { padding: 16rpx 0 28rpx; }
.spec-remark-input {
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
}

.spec-foot {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 30rpx;
  border-top: 2rpx solid #f2f3f5;
  background: #fff;
}
/* 份数步进器 */
.stepper { display: flex; align-items: center; }
.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f2f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #303133;
  line-height: 1;
}
.step-btn.minus.disabled { color: #c0c4cc; background: #f6f7f9; }
.step-btn.plus { background: #ff6b2c; color: #fff; }
.step-qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}
.spec-total { flex: 1; text-align: right; font-size: 26rpx; color: #606266; margin-right: 24rpx; }
.spec-confirm {
  flex-shrink: 0;
  min-width: 220rpx;
  text-align: center;
  line-height: 80rpx;
  height: 80rpx;
  font-size: 28rpx;
  background: #ff6b2c;
  color: #fff;
  border-radius: 40rpx;
  font-weight: 600;
}
